# Search indexing. Off until the shop owner approves.
# Only the exact value true allows indexing. Anything else (including blank)
# makes robots.txt disallow all, sets noindex/nofollow metadata, and sends
# X-Robots-Tag: noindex, nofollow. Read at build time — redeploy after changing it.
ALLOW_INDEXING=

# Public site origin for canonical URLs, Open Graph, sitemap, and JSON-LD.
# On Vercel this can stay blank: VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used.
# Example: https://purplebagel.example
NEXT_PUBLIC_SITE_URL=

# Which provider texts the shop when a bulk pre-order form is submitted.
# bland — POST to Bland SMS (https://docs.bland.ai/api-v1/post/sms-send)
# log  — log the pre-order and do not send
# blank — same as log: the form still succeeds and asks the customer to text the shop line
SMS_PROVIDER=

# E.164 number that receives the shop alert. Not decided yet.
# Example: +19045748002
PREORDER_NOTIFY_TO=

# E.164 number Bland sends from (an agent number on the Bland account).
PREORDER_SMS_FROM=

# Bland API key. Required only when SMS_PROVIDER=bland and you want a live send.
BLAND_API_KEY=
